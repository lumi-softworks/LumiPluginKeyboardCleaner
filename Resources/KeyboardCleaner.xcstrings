    "Allow Lumi in System Settings > Privacy & Security > Accessibility to block keyboard input while cleaning.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Lumi in System Settings > Privacy & Security > Accessibility to block keyboard input while cleaning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系统设置 > 隐私与安全性 > 辅助功能」中允许 Lumi，清洁期间才能屏蔽键盘输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定 > 隱私與安全性 > 輔助使用」中允許 Lumi，清潔期間才能封鎖鍵盤輸入。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定 > 隱私與安全性 > 輔助使用」中允許 Lumi，清潔期間才能封鎖鍵盤輸入。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系統設定 > 隱私與安全性 > 輔助使用」中允許 Lumi，清潔期間才能封鎖鍵盤輸入。"
          }
        }
      }
    },
