    "The keyboard blocker could not start. Check that Lumi is allowed in System Settings > Privacy & Security > Accessibility, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The keyboard blocker could not start. Check that Lumi is allowed in System Settings > Privacy & Security > Accessibility, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "键盘拦截未能启动。请在「系统设置 > 隐私与安全性 > 辅助功能」中允许 Lumi，然后再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤攔截未能啟動。請在「系統設定 > 隱私與安全性 > 輔助使用」中允許 Lumi，然後再試一次。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤攔截未能啟動。請在「系統設定 > 隱私與安全性 > 輔助使用」中允許 Lumi，然後再試一次。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵盤攔截未能啟動。請在「系統設定 > 隱私與安全性 > 輔助使用」中允許 Lumi，然後再試一次。"
          }
        }
      }
    },
    "Keyboard input is ignored system-wide during cleaning. Hold ⌃ ⌥ ⇧ + Esc for 1 second to exit at any time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard input is ignored system-wide during cleaning. Hold ⌃ ⌥ ⇧ + Esc for 1 second to exit at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清洁期间全系统忽略键盘输入。按住 ⌃ ⌥ ⇧ + Esc 1 秒可随时退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清潔期間全系統忽略鍵盤輸入。按住 ⌃ ⌥ ⇧ + Esc 1 秒可隨時退出。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "清潔期間全系統忽略鍵盤輸入。按住 ⌃ ⌥ ⇧ + Esc 1 秒可隨時退出。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "清潔期間全系統忽略鍵盤輸入。按住 ⌃ ⌥ ⇧ + Esc 1 秒可隨時退出。"
          }
        }
      }
    },
