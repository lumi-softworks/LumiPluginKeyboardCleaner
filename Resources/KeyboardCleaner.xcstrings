    "The mouse keeps working, so you can use the overlay button at any time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mouse keeps working, so you can use the overlay button at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标始终可用，随时可以点击遮罩上的按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠始終可用，隨時可以點擊遮罩上的按鈕。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠始終可用，隨時可以點擊遮罩上的按鈕。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠始終可用，隨時可以點擊遮罩上的按鈕。"
          }
        }
      }
    },
    "All keyboard input is ignored system-wide, including shortcuts, function keys, and media keys.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All keyboard input is ignored system-wide, including shortcuts, function keys, and media keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全系统忽略所有键盘输入，包括快捷键、功能键与媒体键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全系統忽略所有鍵盤輸入，包括快速鍵、功能鍵與媒體鍵。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "全系統忽略所有鍵盤輸入，包括快速鍵、功能鍵與媒體鍵。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "全系統忽略所有鍵盤輸入，包括快速鍵、功能鍵與媒體鍵。"
          }
        }
      }
    },
    "Modifier keys and Caps Lock do not change state while the session is active.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier keys and Caps Lock do not change state while the session is active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话期间修饰键与 Caps Lock 不会改变状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段期間修飾鍵與 Caps Lock 不會改變狀態。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
