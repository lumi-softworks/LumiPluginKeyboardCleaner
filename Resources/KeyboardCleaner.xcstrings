          }
        }
      }
    },
    "The display stays awake for the whole session, so the countdown remains visible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display stays awake for the whole session, so the countdown remains visible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个会话期间屏幕保持常亮，倒计时始终可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個工作階段期間螢幕保持常亮，倒數計時始終可見。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
