    "Or hold Control, Option, Shift, and Esc together for one second. All four keys must be held at the same time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or hold Control, Option, Shift, and Esc together for one second. All four keys must be held at the same time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或同时按住 Control、Option、Shift 和 Esc 一秒。四个键必须同时按住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或同時按住 Control、Option、Shift 和 Esc 一秒。四個鍵必須同時按住。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "或同時按住 Control、Option、Shift 和 Esc 一秒。四個鍵必須同時按住。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "或同時按住 Control、Option、Shift 和 Esc 一秒。四個鍵必須同時按住。"
          }
        }
      }
    },
    "Otherwise the session ends automatically when the selected duration runs out.": {
