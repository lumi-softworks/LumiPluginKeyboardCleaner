    "Keystrokes are never recorded, logged, or stored. The plugin only checks whether the unlock shortcut is held.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keystrokes are never recorded, logged, or stored. The plugin only checks whether the unlock shortcut is held."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件不会记录、写入日志或保存按键内容，只检查解锁组合键是否被按住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛不會記錄、寫入日誌或儲存按鍵內容，只檢查解鎖組合鍵是否被按住。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛不會記錄、寫入日誌或儲存按鍵內容，只檢查解鎖組合鍵是否被按住。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛不會記錄、寫入日誌或儲存按鍵內容，只檢查解鎖組合鍵是否被按住。"
          }
        }
      }
    },
    "There is no unlimited mode. A session lasts at most five minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no unlimited mode. A session lasts at most five minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不提供无限模式，单次会话最长五分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不提供無限模式，單次工作階段最長五分鐘。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "不提供無限模式，單次工作階段最長五分鐘。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "不提供無限模式，單次工作階段最長五分鐘。"
          }
        }
      }
    },
    "For liquid cleaning, turn off or unplug the keyboard first. This plugin only prevents accidental typing; it does not protect the hardware.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For liquid cleaning, turn off or unplug the keyboard first. This plugin only prevents accidental typing; it does not protect the hardware."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用液体清洁时，请先关闭或拔下键盘。本插件只防止误触输入，不保护硬件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用液體清潔時，請先關閉或拔下鍵盤。此外掛只防止誤觸輸入，不保護硬體。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "使用液體清潔時，請先關閉或拔下鍵盤。此外掛只防止誤觸輸入，不保護硬體。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用液體清潔時，請先關閉或拔下鍵盤。此外掛只防止誤觸輸入，不保護硬體。"
          }
        }
      }
    },
