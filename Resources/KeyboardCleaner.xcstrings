    "Enable Keyboard Cleaner in Plugin Management. The plugin is disabled by default.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Keyboard Cleaner in Plugin Management. The plugin is disabled by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「插件管理」中启用键盘清洁。该插件默认关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「外掛管理」中啟用鍵盤清潔。該外掛預設關閉。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在「外掛管理」中啟用鍵盤清潔。該外掛預設關閉。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在「外掛管理」中啟用鍵盤清潔。該外掛預設關閉。"
          }
        }
      }
    },
    "Open System Settings > Privacy & Security > Accessibility and allow Lumi. Without this permission the keyboard blocker cannot start.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings > Privacy & Security > Accessibility and allow Lumi. Without this permission the keyboard blocker cannot start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「系统设置 > 隐私与安全性 > 辅助功能」并允许 Lumi。没有该权限，键盘拦截无法启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「系統設定 > 隱私與安全性 > 輔助使用」並允許 Lumi。沒有該權限，鍵盤攔截無法啟動。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「系統設定 > 隱私與安全性 > 輔助使用」並允許 Lumi。沒有該權限，鍵盤攔截無法啟動。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「系統設定 > 隱私與安全性 > 輔助使用」並允許 Lumi。沒有該權限，鍵盤攔截無法啟動。"
          }
        }
      }
    },
    "Make sure the keyboard you want to clean is connected and working normally.": {
      "localizations": {
