    "A full-screen overlay appears on every display. Keyboard input stops responding from that moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen overlay appears on every display. Keyboard input stops responding from that moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每块屏幕都会出现全屏遮罩，键盘输入从那一刻起不再响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每塊螢幕都會出現全螢幕遮罩，鍵盤輸入從那一刻起不再回應。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
